+/// Controls memory mappings in a target process. Unlike ControlMemory, this is the one SVC
+/// that may create executable mappings; loaders use it to make injected code executable.
+Result SVC::ControlProcessMemory(Handle process_handle, u32 addr0, u32 addr1, u32 size,
+                                 u32 operation, u32 permissions) {
+    LOG_DEBUG(Kernel_SVC,
+              "called process=0x{:08X}, addr0=0x{:08X}, addr1=0x{:08X}, size=0x{:X}, "
+              "operation=0x{:08X}, permissions=0x{:08X}",
+              process_handle, addr0, addr1, size, operation, permissions);
+
+    Result result = ResultSuccess;
+
+    const std::shared_ptr<Process> process =
+        kernel.GetCurrentProcess()->handle_table.Get<Process>(process_handle);
+    if (!process) {
+        result = ResultInvalidHandle;
+    } else {
+        operation &= ~MEMOP_REGION_MASK;
+
+        switch (operation & MEMOP_OPERATION_MASK) {
+        case MEMOP_MAP:
+        case MEMOP_UNMAP: {
+            if ((addr0 & Memory::CITRA_PAGE_MASK) != 0 || (addr1 & Memory::CITRA_PAGE_MASK) != 0) {
+                result = ResultMisalignedAddress;
+            } else if ((size & Memory::CITRA_PAGE_MASK) != 0) {
+                result = ResultMisalignedSize;
+            } else if ((permissions & ~static_cast<u32>(VMAPermission::ReadWriteExecute)) != 0) {
+                // Executable permissions are the purpose of this SVC, but nothing outside
+                // Read/Write/Execute is meaningful.
+                result = ResultInvalidCombination;
+            } else {
+                const auto vma_permissions = static_cast<VMAPermission>(permissions);
+                if ((operation & MEMOP_OPERATION_MASK) == MEMOP_MAP) {
+                    result = process->Map(addr0, addr1, size, vma_permissions, true);
+                } else {
+                    result = process->Unmap(addr0, addr1, size, vma_permissions, true);
+                }
+            }
+            break;
+        }
+        case MEMOP_PROTECT: {
+            if ((addr0 & Memory::CITRA_PAGE_MASK) != 0) {
+                result = ResultMisalignedAddress;
+            } else if ((size & Memory::CITRA_PAGE_MASK) != 0) {
+                result = ResultMisalignedSize;
+            } else if (permissions == 0 ||
+                       (permissions & ~static_cast<u32>(VMAPermission::ReadWriteExecute)) != 0) {
+                result = ResultInvalidCombination;
+            } else {
+                result = process->vm_manager.ReprotectRange(
+                    addr0, size, static_cast<VMAPermission>(permissions));
+            }
+            break;
+        }
+        default:
+            LOG_ERROR(Kernel_SVC, "unknown operation=0x{:08X}", operation);
+            result = ResultInvalidCombination;
+            break;
+        }
+    }
+
+    LOG_INFO(Kernel_SVC, "[MODDBG] SVC 0x70 ControlProcessMemory op={} result={:#010x}",
+             operation & MEMOP_OPERATION_MASK, result.raw);
+    return result;
+}
+
